# Copy this file to .env and fill in your own keys. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=

# Which provider the agents use first: groq | gemini | ollama
LLM_PROVIDER=groq
# Tried in order when the primary rate-limits or fails (providers without a key are skipped)
LLM_FALLBACKS=gemini
# Overrides the primary provider's model; per-provider models below
LLM_MODEL=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=gemma4:e2b

# Local fallback (Ollama runs on this address by default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Sandbox: auto (Docker if running, else subprocess) | docker | subprocess
SANDBOX_MODE=auto

# Overdue approvals escalate to the lead after this many minutes (0 turns it off)
APPROVAL_SLA_MINUTES=10
