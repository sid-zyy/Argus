# Copy this file to .env and fill in your own keys. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
# Free backup: create a key at https://openrouter.ai/keys (free models need no credit)
OPENROUTER_API_KEY=

# Which provider the agents use first: groq | gemini | openrouter | ollama
LLM_PROVIDER=groq
# Tried in order when the primary rate-limits or fails (providers without a key are skipped)
LLM_FALLBACKS=gemini,openrouter
# Overrides the primary provider's model; per-provider models below
LLM_MODEL=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=gemma4:e2b
# Free OpenRouter models change often: pick current ones at https://openrouter.ai/models?max_price=0&supported_parameters=tools
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free

# Local fallback (Ollama runs on this address by default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Sandbox: auto (Docker if running, else subprocess) | docker | subprocess
SANDBOX_MODE=auto

# Overdue approvals escalate to the lead after this many minutes (0 turns it off)
APPROVAL_SLA_MINUTES=10
# 1 = critical/major fixes need two people (a developer and a team lead); 0 = one developer or lead
TWO_PERSON_APPROVAL=0
